# Estes valores são INLINADOS no bundle em tempo de build e vão junto no
# instalador, que é extraível. Nunca coloque segredo aqui.
#
# Já existem .env.development e .env.production versionados com os valores
# padrão. Use .env.local (ignorado pelo git) para sobrescrever na sua máquina.
APP_API_BASE_URL=http://localhost/api/admin/
APP_WS_BASE_URL=http://localhost:3002
