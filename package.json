{
  "name": "sgrande-delivery-printer-2",
  "version": "2.7.0",
  "description": "SGrande Delivery Printer 2 - Impress\u00e3o autom\u00e1tica dos pedidos",
  "author": {
    "name": "SGrande Delivery",
    "email": "contato@sgrande.delivery"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelcarreiro/delivery-printer-2.git"
  },
  "main": "./out/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder build --publish never",
    "release": "npm run build && electron-builder build --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "axios": "^1.12.2",
    "electron": "^43.7.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "history": "^5.3.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "build": {
    "productName": "SGrande Delivery Printer",
    "appId": "com.sgrande.delivery",
    "asar": true,
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      "./assets/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "raphaelcarreiro",
      "repo": "delivery-printer-2",
      "private": true,
      "releaseType": "prerelease"
    }
  }
}
