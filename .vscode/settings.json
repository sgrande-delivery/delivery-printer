{
  "files.associations": {
    ".prettierrc": "jsonc"
  },

  "eslint.validate": ["javascript", "typescript", "typescriptreact"],

  "javascript.validate.enable": false,
  "javascript.format.enable": false,
  "typescript.format.enable": false,

  "search.exclude": {
    ".git": true,
    ".eslintcache": true,
    "out": true,
    "release": true,
    "node_modules": true,
    "package-lock.json": true
  }
}
